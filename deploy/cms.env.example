# /etc/dominik-art/cms.env  (owner root, mode 600) - read by systemd
CMS_REPO=/srv/dominik-art/repo
CMS_INSTANCE=/srv/dominik-art/instance
CMS_BUILD=/srv/dominik-art/build
CMS_WWW=/srv/dominik-art/www
CMS_RACO=/opt/racket-9.3/bin/raco
CMS_PUSH=1
CMS_SECURE_COOKIES=1
# for suggested photo descriptions and search texts (optional):
ANTHROPIC_API_KEY=
